# Nonsecret key inventory. Run npm run setup:local for fresh ignored local values.
DATABASE_URL=postgresql://infame_dev:REPLACE@127.0.0.1:5644/infame_TASK_dev
AUTH_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
APP_ORIGIN=http://localhost:3000
INFAME_ENV=development
INFAME_TASK_ID=REPLACE_WITH_ISOLATED_TASK_ID
# fixture only for isolated development; resend requires verified sender credentials.
DELIVERY_MODE=unavailable
# Set only behind a deployment ingress which overwrites forwarded-IP headers.
TRUST_PROXY_HEADERS=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SOCIAL_TOKEN_KEY=
EMAIL_FROM=
RESEND_API_KEY=
SMS_PROVIDER=unavailable
SMS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=infame-evidence
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
X_BEARER_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
# Optional licensed Studio registry credentials, server/CLI only.
SHADCN_STUDIO_EMAIL=
SHADCN_STUDIO_LICENSE_KEY=
