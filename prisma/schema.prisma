// Additive private context/planning projection; SQL owns native checks and triggers.
// Apply only together with the existing-model additions in the companion file.
// The migration owns partial indexes, CHECK constraints and lifecycle triggers.
// New TEXT identifiers have no database default. No automatic updatedAt writes.

enum PlanningWorkspaceScope {
  OWN_BRAND
  CLIENT
}

enum PlanningReviewState {
  PENDING
  APPROVED
  DECLINED
}

model PlanningWorkspace {
  id               String                  @id
