  brand            Brand                   @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client           OrganizationClient?     @relation(fields: [clientId, organizationId, brandId], references: [id, organizationId, brandId], onDelete: Restrict, onUpdate: Restrict)
  contexts         BrandContext[]
  campaignBindings CampaignPlanningBinding[]

  @@unique([id, brandId])
  @@index([clientId, organizationId, brandId], map: "PlanningWorkspace_client_scope")
  // SQL-only partial uniques: PlanningWorkspace_own_brand, PlanningWorkspace_client.
}

model BrandContext {
