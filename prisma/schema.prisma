  content                   Json                   @db.JsonB
  contentHash               String
  submittedByUserId         String
  targetOwnerUserId         String
  targetOwnerSessionVersion Int
  clientRevision            Int?
  state                     PlanningReviewState    @default(PENDING)
  revision                  Int                    @default(1)
  decidedByUserId           String?
  decidedAt                 DateTime?              @db.Timestamp(3)
  createdAt                 DateTime               @default(now()) @db.Timestamp(3)
  context                   BrandContext           @relation(fields: [contextId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
