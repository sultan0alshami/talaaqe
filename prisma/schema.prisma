  manifestId        String
  manifestHash      String
  createdAt         DateTime @default(now()) @db.Timestamp(3)

  @@index([contextId, workspaceId])
  @@index([manifestId, contextId, workspaceId, referenceRevision, manifestHash], map: "ContextSubmissionReferences_manifest")
}

model ContextReferenceCommand {
  id           String   @id
  actorUserId  String
  operationKey String
  payloadHash  String
  contextId    String
  workspaceId  String
  action       String
  manifestId   String
  result       Json     @db.JsonB
  createdAt    DateTime @default(now()) @db.Timestamp(3)

  @@unique([actorUserId, operationKey])
  @@index([contextId, workspaceId])
  @@index([manifestId])
}

// Additive M04A customer disclosure. Composite retention and snapshot/sequence
// guards are SQL-owned, matching the existing reference sidecar convention.
model ManagedOrder {
  id          String   @id
  workspaceId String
  campaignId  String   @unique
  createdAt   DateTime @default(now()) @db.Timestamp(3)

  @@unique([id, workspaceId, campaignId])
  @@unique([id, workspaceId])
  @@index([workspaceId, id], map: "ManagedOrder_workspace_id")
}

model ManagedOrderSubmission {
  id                           String   @id
  orderId                      String
  workspaceId                  String
  campaignId                   String
  version                      Int
  briefId                      String
  briefVersion                 Int
  inputRevision                Int
  campaignRevision             Int
  planningRevision             Int
  selectionId                  String
  selectionRevision            Int
  approvedByUserId             String
  approvedAt                   DateTime @db.Timestamp(3)
  contextReferenceSubmissionId String?
  snapshot                     Json     @db.JsonB
  snapshotHash                 String
  submittedByUserId            String
  disclosureVersion            String
  createdAt                    DateTime @default(now()) @db.Timestamp(3)

  @@unique([orderId, version])
  @@unique([id, orderId, workspaceId, campaignId, version])
  @@unique([id, orderId, workspaceId, version])
  @@index([workspaceId, orderId], map: "ManagedOrderSubmission_workspace_order")
  @@index([briefId, campaignId, workspaceId, selectionId, selectionRevision], map: "ManagedOrderSubmission_provenance")
  @@index([contextReferenceSubmissionId], map: "ManagedOrderSubmission_reference")
  @@index([approvedByUserId], map: "ManagedOrderSubmission_approver")
  @@index([submittedByUserId], map: "ManagedOrderSubmission_submitter")
}

model ManagedOrderState {
  orderId           String   @id
  workspaceId       String
  revision          Int
  submissionId      String
  submissionVersion Int
  status            String
  createdAt         DateTime @default(now()) @db.Timestamp(3)
  updatedAt         DateTime @db.Timestamp(3)

  @@index([workspaceId, orderId], map: "ManagedOrderState_workspace_order")
  @@index([submissionId, orderId, workspaceId, submissionVersion], map: "ManagedOrderState_submission")
}

model ManagedOrderCommand {
  id                String   @id
  actorUserId       String
  operationKey      String
  payloadHash       String
  orderId           String
  workspaceId       String
  campaignId        String
  submissionId      String
  submissionVersion Int
  action            String
  result            Json     @db.JsonB
  createdAt         DateTime @default(now()) @db.Timestamp(3)

  @@unique([actorUserId, operationKey])
  @@index([workspaceId, orderId], map: "ManagedOrderCommand_workspace_order")
  @@index([submissionId, orderId, workspaceId, campaignId, submissionVersion], map: "ManagedOrderCommand_submission")
}

// Additive M04B2 declarations. SQL owns restrictive composite pointers and
// lifecycle/sequence guards. These records alone confer no managed authority.
model InfamePrincipal {
  id         String   @id
  provenance String
  createdAt  DateTime @default(now()) @db.Timestamp(3)

  @@unique([id, provenance])
}

model InfamePrincipalVersion {
  id          String   @id
  principalId String
  provenance  String
  version     Int
  content     Json     @db.JsonB
  sourceHash  String
  createdAt   DateTime @default(now()) @db.Timestamp(3)

  @@unique([principalId, version])
  @@unique([id, principalId, version, sourceHash])
  @@unique([id, principalId, provenance, version, sourceHash])
}

model InfamePrincipalState {
  principalId          String   @id
  revision             Int
  state                String
  currentVersionId     String?
  currentVersionNumber Int?
  currentSourceHash    String?
  createdAt            DateTime @default(now()) @db.Timestamp(3)
  updatedAt            DateTime @db.Timestamp(3)

  @@index([currentVersionId, principalId, currentVersionNumber, currentSourceHash], map: "InfamePrincipalState_current_version")
  @@index([state, principalId], map: "InfamePrincipalState_available")
}

// Inert Schema23A storage interfaces. SQL owns exact native/source pointers,
// lifecycle guards and retention. No importer or executable admission exists.
model LegacyDirectAdmission {
  id            String   @id
  provenance    String
  capability    String
  campaignId    String
  brandId       String
  brandUserId   String
  creatorId     String
  creatorUserId String
  createdAt     DateTime @default(now()) @db.Timestamp(3)

  @@unique([id, provenance, capability])
  @@index([campaignId, creatorId])
}

model LegacyDirectAdmissionVersion {
  id                    String   @id
  admissionId           String
  provenance            String
  capability            String
  version               Int
  content               Json     @db.JsonB
  sourceHash            String
  createdAt             DateTime @default(now()) @db.Timestamp(3)
  approvedBriefId       String
  approvedBriefVersion  Int
  approvedInputRevision Int
  approvedByUserId      String
  approvedContentHash   String
  manifestId            String
  manifestEntryId       String
  sourceActorUserId      String
  sourceOperationKey    String
  sourcePayloadHash     String
  sourceResultHash      String
  campaignCommandId     String?
  dealCommandId         String?
  existingDealId        String?
  existingDealHash      String?
  firstOfferId          String?
  firstOfferVersion     Int?
  firstProposerUserId   String?
  firstRecipientUserId  String?
  firstOfferContentHash String?

  @@unique([admissionId, version])
  @@unique([id, admissionId, version, sourceHash])
  @@unique([id, admissionId, provenance, capability, version, sourceHash])
  @@index([approvedBriefId])
  @@index([campaignCommandId])
  @@index([dealCommandId])
  @@index([existingDealId])
  @@index([firstOfferId])
}

model LegacyDirectAdmissionState {
  admissionId          String   @id
  revision             Int
  state                String
  currentVersionId     String?
  currentVersionNumber Int?
  currentSourceHash    String?
  createdAt            DateTime @default(now()) @db.Timestamp(3)
  updatedAt            DateTime @db.Timestamp(3)

  @@index([currentVersionId, admissionId, currentVersionNumber, currentSourceHash], map: "LegacyDirectAdmissionState_current_version")
  @@index([state, admissionId], map: "LegacyDirectAdmissionState_available")
}
